{
  "name": "extended-context-tools",
  "displayName": "Extended Context Tools",
  "description": "Adds Duplicate, File Info, Copy Path, Compare With and Change Case options to the Explorer context menu.",
  "version": "0.3.0",
  "publisher": "evomark",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "extendedContextTools.duplicate",
        "title": "Duplicate",
        "category": "Context Tools"
      },
      {
        "command": "extendedContextTools.fileInfo",
        "title": "File Info",
        "category": "Context Tools"
      },
      {
        "command": "extendedContextTools.copyPath",
        "title": "Copy Path As…",
        "category": "Context Tools"
      },
      {
        "command": "extendedContextTools.compareWith",
        "title": "Compare With…",
        "category": "Context Tools"
      },
      {
        "command": "extendedContextTools.renameCase",
        "title": "Rename: Change Case…",
        "category": "Context Tools"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extendedContextTools.compareWith",
          "group": "3_compare@99",
          "when": "!explorerResourceIsFolder || listMultiSelection"
        },
        {
          "command": "extendedContextTools.duplicate",
          "group": "5_cutcopypaste@50"
        },
        {
          "command": "extendedContextTools.copyPath",
          "group": "6_copypath@99"
        },
        {
          "command": "extendedContextTools.renameCase",
          "group": "7_modification@50"
        },
        {
          "command": "extendedContextTools.fileInfo",
          "group": "7_modification@99"
        }
      ],
      "commandPalette": [
        {
          "command": "extendedContextTools.duplicate",
          "when": "resourceScheme == file"
        },
        {
          "command": "extendedContextTools.fileInfo",
          "when": "resourceScheme == file"
        },
        {
          "command": "extendedContextTools.copyPath",
          "when": "resourceScheme == file"
        },
        {
          "command": "extendedContextTools.compareWith",
          "when": "resourceScheme == file"
        },
        {
          "command": "extendedContextTools.renameCase",
          "when": "resourceScheme == file"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository",
    "install-codium": "codium --install-extension extended-context-tools-$npm_package_version.vsix --force"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
